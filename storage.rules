rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /evidence/{jobId}/{fileName} {
      // Allow read/write if authenticated and file is under 100MB
      // Content type can be image or video
      allow read, write: if request.auth != null
                         && request.resource.size < 100 * 1024 * 1024
                         && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }
  }
}
