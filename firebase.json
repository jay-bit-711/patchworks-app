{
  "functions": [
    {
      "codebase": "python",
      "ignore": [
        "venv",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "source": "functions",
      "runtime": "python313"
    }
    
  ],
  "firestore": {
    "database": "(default)",
    "location": "asia-south1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "hub": {
      "port": 4400
    },
    "logging": {
      "port": 4500
    },
    "hosting": {
      "port": 5000
    },
    "singleProjectMode": true,
    "database": {
      "port": 9000
    }
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "construction-agents",
          "appId": "1:868512832982:android:7c8e4e30ca35a141c71877",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "construction-agents",
          "configurations": {
            "android": "1:868512832982:android:7c8e4e30ca35a141c71877"
          }
        }
      }
    }
  },
  "database": {
    "rules": "database.rules.json"
  },
  "auth": {
    "providers": {}
  }
}
